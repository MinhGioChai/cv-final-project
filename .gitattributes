* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.cjs text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.ipynb text eol=lf
*.docx binary
*.zip binary
*.jpg binary
*.png binary
# Research receipts bind exact bytes; preserve their source line endings.
data/** -text
configs/** -text
reports/** -text whitespace=cr-at-eol
# Source Markdown keeps intentional two-space hard breaks and original CRLF.
docs/archive/** -text whitespace=cr-at-eol,-blank-at-eol
docs/handoffs/** -text whitespace=cr-at-eol,-blank-at-eol
